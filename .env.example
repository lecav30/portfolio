# Server-only origin for anonymous, published-only Payload REST reads.
# Use the local CMS origin in development. Do not add credentials or use a
# NEXT_PUBLIC_ prefix: browser code must never call the CMS directly.
PAYLOAD_CMS_URL=http://127.0.0.1:3011

# Server-only HMAC secret for POST /api/internal/revalidate. Generate at least
# 32 random bytes independently for each environment; never use NEXT_PUBLIC_.
BLOG_REVALIDATION_SECRET=replace-with-a-high-entropy-secret
